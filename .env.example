# Supabase Configuration
# Copy this file to .env.local and fill in your actual values

# Your Supabase project URL (found in Project Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anon/Public key (found in Project Settings > API)
# Use ANON key for frontend applications, NOT the service_role key
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# DO NOT USE service_role key in frontend!
# Service role key should only be used in backend/server-side code
